# scripts/extract_frames.py
"""Extract every Nth frame from a pothole video for training/testing."""
import cv2
import os

VIDEO = "pothole_clip.mp4"
OUTPUT_DIR = "frames/"
EVERY_N = 10  # Extract every 10th frame

os.makedirs(OUTPUT_DIR, exist_ok=True)
cap = cv2.VideoCapture(VIDEO)
i, saved = 0, 0

while cap.isOpened():
    ret, frame = cap.read()
    if not ret:
        break
    if i % EVERY_N == 0:
        cv2.imwrite(f"{OUTPUT_DIR}/frame_{saved:05d}.jpg", frame)
        saved += 1
    i += 1

cap.release()
print(f"Extracted {saved} frames to {OUTPUT_DIR}")
